# --- Database ---
# Use SQLite for local dev (default), or switch to PostgreSQL for production.
#
# SQLite (default — no setup needed):
DATABASE_URL=sqlite:///./testforge.db
#
# PostgreSQL / Render (production):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/testforge_db
# Note: Render automatically provides postgres:// or postgresql:// URLs;
# TestForge AI automatically converts them to postgresql+psycopg:// for SQLAlchemy 2.0.

# --- JWT ---
# IMPORTANT: Change this to a long random string in production.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-random-256bit-hex-string

# Token lifetime in minutes (480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- App ---
APP_ENV=development

# --- OpenRouter ---
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o

# --- Google Gemini ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro

# --- AgentRouter ---
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://co.agentrouter.org/v1
AGENTROUTER_MODEL=

# --- AI Settings ---
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
